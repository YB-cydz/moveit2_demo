<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="tianyi2_complete">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import tianyi2_complete urdf file -->
    <xacro:include filename="$(find tianyi2_urdf)/urdf/tianyi2_urdf_with_hands.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="tianyi2_complete.ros2_control.xacro" />


    <xacro:tianyi2_complete_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
